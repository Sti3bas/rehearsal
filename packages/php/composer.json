{
  "name": "sti3bas/rehearsal",
  "description": "Parallel Playwright testing for Laravel",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0"
  },
  "autoload": {"psr-4": {"Sti3bas\\Rehearsal\\": "src/"}},
  "autoload-dev": {"psr-4": {"Sti3bas\\Rehearsal\\Tests\\": "tests/"}},
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}},
  "extra": {"laravel": {"providers": ["Sti3bas\\Rehearsal\\ServiceProvider"]}},
  "scripts": {"test": "pest"}
}
