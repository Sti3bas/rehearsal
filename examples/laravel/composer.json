{
  "name": "rehearsal/example",
  "type": "project",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "require-dev": {
    "sti3bas/rehearsal": "@dev",
    "fakerphp/faker": "^1.23",
    "laravel/scout": "^11",
    "laravel/reverb": "^1",
    "meilisearch/meilisearch-php": "^1",
    "typesense/typesense-php": "^6"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/"}},
  "repositories": [{"type": "path", "url": "../../packages/php"}],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"]}
}
