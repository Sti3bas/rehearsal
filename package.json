{
  "name": "@sti3bas/rehearsal",
  "version": "0.2.0",
  "description": "Parallel Playwright testing for Laravel",
  "license": "MIT",
  "type": "module",
  "engines": {"node": "^22.18.0 || ^24.0.0"},
  "workspaces": ["examples/nuxt"],
  "exports": {
    ".": {"types": "./packages/ts/dist/index.d.ts", "default": "./packages/ts/dist/index.js"},
    "./ssr": {"types": "./packages/ts/dist/ssr.d.ts", "default": "./packages/ts/dist/ssr.js"},
    "./nuxt": {"types": "./packages/ts/dist/nuxt.d.ts", "default": "./packages/ts/dist/nuxt.js"},
    "./reporter": {"types": "./packages/ts/dist/reporter.d.ts", "default": "./packages/ts/dist/reporter.js"}
  },
  "files": ["packages/ts/dist"],
  "dependencies": {"msw": "^3.0.8", "ofetch": "^1.5.1"},
  "peerDependencies": {"@nuxt/kit": "^4.0.0", "@playwright/test": "^1.65.1"},
  "peerDependenciesMeta": {"@nuxt/kit": {"optional": true}},
  "devDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.2"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p packages/ts",
    "test": "tsc -p packages/ts/tests/tsconfig.types.json && vitest run packages/ts/tests",
    "e2e": "cd examples/laravel && playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  }
}
